# ── Desarrollo local ──────────────────────────────────────
# Base de datos (PostgreSQL en docker-compose.dev.yml, puerto host 5433)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/ZenithOpsDatabase

# Aplicación
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production

# Sentry (opcional en local — dejar SENTRY_DSN vacío para desactivar)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0.0

# MLflow (se activa en Fase 2)
# MLFLOW_TRACKING_URI=http://localhost:5000

# ── Producción (VPS) ──────────────────────────────────────
# Copia esta sección a /opt/zenith-ops/.env en el VPS. No commitear secretos reales.
#
# Host PostgreSQL 16 nativo (no contenedor). host.docker.internal requiere
# extra_hosts: host-gateway en docker-compose.prod.yml (ya configurado).
DATABASE_URL=postgresql+asyncpg://zenith:CHANGE_ME@host.docker.internal:5432/ZenithOpsDatabase

ENVIRONMENT=production
LOG_FORMAT=json
LOG_LEVEL=INFO
SECRET_KEY=generate-a-strong-random-secret-on-the-vps

# Sentry — crear proyecto en sentry.io y pegar el DSN aquí (o en GitHub Secrets / VPS .env)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Imágenes GHCR (públicas). CD fija IMAGE_TAG al commit SHA en cada deploy.
# GHCR_OWNER = dueño del repo en minúsculas (p. ej. mi-org o mi-usuario).
GHCR_OWNER=your-github-owner-lowercase
IMAGE_TAG=latest
